<!DOCTYPE html>
<html>
<head>
    <title>Master Login</title>
    <style>
        body {
            background-color: #f6f8fa;
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .login-container {
            background-color: #ffffff;
            padding: 25px;
            border: 1px solid #d0d7de;
            border-radius: 6px;
            width: 300px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        .login-container h2 {
            text-align: center;
            margin-bottom: 20px;
        }

        label {
            font-size: 14px;
            font-weight: bold;
        }

        input {
            width: 100%;
            padding: 8px;
            margin: 8px 0 15px 0;
            border: 1px solid #d0d7de;
            border-radius: 4px;
        }

        button {
            width: 100%;
            padding: 8px;
            background-color: #2da44e;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
        }

        button:hover {
            background-color: #218838;
        }

        .footer {
            text-align: center;
            margin-top: 15px;
            font-size: 13px;
        }

        .footer a {
            text-decoration: none;
            color: #0969da;
        }
    </style>
</head>

<body>

<div class="login-container">
    <h2>Sign in to GitHub</h2>
    
    <form>
        <label>Username or email address</label>
        <input type="text" placeholder="Enter username">

        <label>Password</label>
        <input type="password" placeholder="Enter password">

        <button type="submit">Sign in</button>
    </form>

    <div class="footer">
        <p>New to GitHub? <a href="#">Create an account</a></p>
    </div>
</div>

</body>
</html>
